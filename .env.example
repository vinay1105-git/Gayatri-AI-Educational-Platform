# Gayatri AI - Enterprise Educational Intelligence Platform
# Copy this file to .env and update values for your environment.

# Application
APP_NAME=Gayatri AI
APP_ENV=development
DEBUG=false
API_V1_PREFIX=/api/v1

# Security (Generate a strong 32+ byte secret for production)
SECRET_KEY=replace-with-a-cryptographically-random-secret-key-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database
# Default uses SQLite for zero-config local startup; switch to PostgreSQL in production:
# DATABASE_URL=postgresql+psycopg2://gayatri_user:strong_password@localhost:5432/gayatri_ai
DATABASE_URL=sqlite:///./data/gayatri_ai.db

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# ML Artifacts & Logging
ML_ARTIFACTS_DIR=./ml_artifacts
LOG_LEVEL=INFO

# Optional External LLM Provider Key (Platform operates fully offline with built-in hybrid RAG/ML engine if unset)
OPENAI_API_KEY=

# Frontend API Base URL (used by Vite)
VITE_API_BASE_URL=http://localhost:8000/api/v1
